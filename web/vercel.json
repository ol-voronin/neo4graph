{
  "regions": ["fra1"],
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "headers": [
    { "source": "/api/((?!graph$).*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/api/graph", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400" }] }
  ]
}
